class Solution {
    public int longestMonotonicSubarray(int[] arr) {
        int n=arr.length;
        int count1=1;
        int count2=1;
        if(n==1){
            return 1;
        }
        int max=0;
        for(int i=1;i<n;i++){
            if(arr[i]>arr[i-1]){
                count1++;
            }
            else count1=1;
            max=Math.max(count1,max);

        }
            for(int i=1;i<n;i++){
                if(arr[i]<arr[i-1]){
                    count2++;
                }
                else count2=1;
                max=Math.max(count2,max);
            }
        return max;
    }
}
