class Solution {
    public int missingInteger(int[] arr) {
        int n=arr.length;
        int sum=arr[0];
        for(int i=0;i<n-1;i++){
            if(arr[i]+1==arr[i+1]){
                sum+=arr[i+1];
            }
            else if(arr[i]+1!=arr[i+1]){
                break;
            }
        }
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
            if(sum==arr[j]){
               sum++;break;
            }
        }
            }
            return sum;
    }
}
