class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        List<Integer> nums2=new ArrayList<>();
        int k=0;
       int n=nums.length;
       int max=nums[0],min=nums[0];
       for(int i=0;i<n;i++){
        if(nums[i]>max){
            max=nums[i];
        }
       }
       for(int i=0;i<n;i++){
        if(nums[i]<min){
            min=nums[i];
        }
       }
       for(int i=min;i<=max;i++){
        boolean found=false;
        for(int j=0;j<n;j++){
        if(i==nums[j]){
            found=true;
            break;
        }
       }
       if(!found){
        nums2.add(i);
       }
       }
       return nums2;
    }
}
